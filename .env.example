# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL="sqlitecloud://<host>:<port>/<db>?apikey=<apikey>"

# Long random string for Starlette SessionMiddleware (e.g. `openssl rand -hex 32`)
SESSION_SECRET_KEY="change-me-to-a-long-random-value"
# Set to true when serving over HTTPS
SESSION_HTTPS_ONLY="false"

REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_USERNAME=""
REDIS_PASSWORD=""
